# IP address of the Roomba on your local network
ROOMBA_IP=192.168.1.50

# BLID (device username) obtained via collector/pairing.py
ROOMBA_BLID=

# Local MQTT password obtained via collector/pairing.py
ROOMBA_PASSWORD=

# "non-mapping" (600/900-series without vSLAM, e.g. 690/692)
# "mapping" (900-series with vSLAM, e.g. 960/980)
ROOMBA_MODEL_CLASS=non-mapping

# Path to the SQLite database file, shared by collector and api
ROOMBA_DB_PATH=./data/roomba.db
